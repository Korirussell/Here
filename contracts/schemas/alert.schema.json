{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://here.local/contracts/alert.schema.json",
  "title": "alert",
  "description": "Top-right panel + belt. active=false when it ends.",
  "type": "object",
  "properties": {
    "type": {
      "const": "alert"
    },
    "v": {
      "const": 3
    },
    "src": {
      "enum": [
        "laptop",
        "phone",
        "relay",
        "dashboard",
        "memory",
        "tool"
      ]
    },
    "t": {
      "type": "number",
      "description": "observation time, laptop clock, unix seconds"
    },
    "seq": {
      "type": "integer"
    },
    "session": {
      "type": "string",
      "description": "set by the relay"
    },
    "alert_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "doorbell",
        "name_called",
        "dog_barking",
        "baby_crying",
        "knock",
        "alarm",
        "loud_bang",
        "car_horn",
        "siren",
        "door"
      ]
    },
    "label": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "priority": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "bearing_deg": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": -180,
          "maximum": 180,
          "description": "degrees, world frame (0 = array forward), clockwise positive, (-180, 180]"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ref": {
      "type": "object",
      "properties": {
        "utt_id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "v",
    "src",
    "t",
    "alert_id",
    "kind",
    "label",
    "emoji",
    "priority",
    "bearing_deg",
    "active",
    "confidence"
  ],
  "additionalProperties": false
}
