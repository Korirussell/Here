{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://here.local/contracts/utterance.schema.json",
  "title": "utterance",
  "description": "Sent repeatedly while the utterance grows (final=false), then once with final=true.",
  "type": "object",
  "properties": {
    "type": {
      "const": "utterance"
    },
    "v": {
      "const": 3
    },
    "src": {
      "enum": [
        "laptop",
        "phone",
        "relay",
        "dashboard",
        "memory",
        "tool"
      ]
    },
    "t": {
      "type": "number",
      "description": "observation time, laptop clock, unix seconds"
    },
    "seq": {
      "type": "integer"
    },
    "session": {
      "type": "string",
      "description": "set by the relay"
    },
    "utt_id": {
      "type": "string"
    },
    "t_start": {
      "type": "number"
    },
    "t_end": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "pending": {
      "type": "string"
    },
    "final": {
      "type": "boolean"
    },
    "bearing_deg": {
      "type": "number",
      "exclusiveMinimum": -180,
      "maximum": 180,
      "description": "degrees, world frame (0 = array forward), clockwise positive, (-180, 180]"
    },
    "bearing_spread_deg": {
      "type": "number",
      "minimum": 0
    },
    "source_id": {
      "type": "integer",
      "minimum": 0
    },
    "overlap": {
      "type": "boolean"
    },
    "tone": {
      "anyOf": [
        {
          "enum": [
            "neutral",
            "excited",
            "laughing",
            "shouting",
            "whispering",
            "questioning",
            "sad"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "tone_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "loudness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "engine": {
      "enum": [
        "faster_whisper",
        "scribe_realtime"
      ]
    },
    "stage_ms": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "type",
    "v",
    "src",
    "t",
    "utt_id",
    "t_start",
    "t_end",
    "text",
    "pending",
    "final",
    "bearing_deg",
    "bearing_spread_deg",
    "source_id",
    "overlap",
    "tone",
    "tone_confidence",
    "loudness",
    "engine"
  ],
  "additionalProperties": false
}
