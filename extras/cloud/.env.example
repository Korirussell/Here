# Copy to extras/cloud/.env (never committed).
DATABRICKS_HOST=                               # https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=                              # personal access token
DATABRICKS_JOB_ID=                             # optional; otherwise the job named here-insights is looked up
# optional: session export bundles to Vultr Object Storage (python -m extras.cloud.export_bundle --upload)
VULTR_S3_ENDPOINT=                             # e.g. https://ewr1.vultrobjects.com (shown on the bucket's page)
VULTR_S3_BUCKET=                               # e.g. here-exports
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
