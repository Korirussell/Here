# Copy to extras/memory/.env (never committed). Environment variables of the same name win.
HERE_RELAY_URL=ws://127.0.0.1:8080/ws          # on Vultr: ws://127.0.0.1:8080/ws (same box) or wss://<host>/ws
HERE_RELAY_TOKEN=change-me                     # same value as the relay's HERE_RELAY_TOKEN
HERE_SESSION=demo
NEON_DATABASE_URL=                             # postgresql://...neon.tech/here?sslmode=require ; empty = local SQLite
GEMINI_API_KEY=                                # optional: Ask HERE phrases answers with Gemini; empty = templates
# optional tunables (defaults in extras/memory/config.py)
# HERE_LOCATION=hackathon_hall                 # location_id stamped on live events
# HERE_RETENTION_DAYS=7                        # SPEC §25; seeded data is exempt
# HERE_MEMORY_HOST=127.0.0.1                   # API bind address (Caddy proxies /api on Vultr)
# HERE_MEMORY_PORT=8790
# HERE_MEMORY_SQLITE=                          # local fallback path (default extras/memory/data/memory.sqlite)
# HERE_NEON_TRANSPORT=auto                     # auto | tcp (psycopg, port 5432) | https (Neon SQL over 443)
# HERE_REPLAY_MODEL=0                          # 1 = add zero-shot relevance scores to /api/replay (CPU)
# HERE_REPLAY_MODEL_THREADS=4                  # torch threads for it; more was much slower on a P+E-core laptop
# HERE_RELAY_LOG=logs/relay.jsonl              # /api/status reads the relay log's tail (Vultr: /var/log/here/relay.jsonl)
# HERE_RELAY_HEALTH=http://127.0.0.1:8080/health
