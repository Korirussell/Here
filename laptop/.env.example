# Copy to laptop/.env (never committed). Environment variables of the same name win.
HERE_RELAY_URL=ws://localhost:8080/ws          # primary relay for python -m laptop (local = the reflex path). demo-up keeps its local relay primary and mirrors to a wss:// value here
HERE_RELAY_MIRRORS=                            # optional, comma-separated: also publish here (e.g. the Vultr wss URL while HERE_RELAY_URL is local)
HERE_RELAY_TOKEN=change-me                     # same value as the relay's HERE_RELAY_TOKEN
HERE_SESSION=demo
ELEVENLABS_API_KEY=                            # Scribe Realtime, once we have access at the event
GEMINI_API_KEY=                                # optional: perception_enrichment.context (laptop/enrich/gemini.py)
HF_TOKEN=                                      # only if a gated Hugging Face model needs it (none do today)
