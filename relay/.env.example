# Copy to relay/.env on the server (never committed). See relay/DEPLOY.md.
HERE_RELAY_TOKEN=change-me      # long random string: python -c "import secrets; print(secrets.token_urlsafe(24))"
HERE_RELAY_HOST=127.0.0.1       # Caddy terminates TLS in front; 0.0.0.0 only for the local fallback relay
HERE_RELAY_PORT=8080
HERE_RELAY_LOG=logs/relay.jsonl
